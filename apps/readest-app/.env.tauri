NEXT_PUBLIC_APP_PLATFORM=tauri
DBUS_ID=com.biblophile.readest
# NOTE: Do NOT set TAURI_DEV_HOST here.
# The Tauri CLI injects it automatically:
#   - For the iOS Simulator: localhost
#   - For a physical device:  your Mac's LAN IP (e.g. 192.168.x.x)
# Hardcoding it here breaks one of the two targets.