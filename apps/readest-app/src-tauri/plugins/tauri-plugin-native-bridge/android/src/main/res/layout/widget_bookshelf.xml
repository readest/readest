          <ImageView android:id="@+id/cover_title_1_2" style="@style/BookshelfWidgetCoverWithTitle" />
          <TextView android:id="@+id/title_1_2" style="@style/BookshelfWidgetTitle" />
          <FrameLayout style="@style/BookshelfWidgetCellSpacer" />
