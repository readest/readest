          <FrameLayout style="@style/BookshelfWidgetCellSpacer" />
          <ImageView android:id="@+id/cover_2_0" style="@style/BookshelfWidgetCover" />
          <ImageView android:id="@+id/cover_title_2_0" style="@style/BookshelfWidgetCoverWithTitle" />
          <TextView android:id="@+id/title_2_0" style="@style/BookshelfWidgetTitle" />
