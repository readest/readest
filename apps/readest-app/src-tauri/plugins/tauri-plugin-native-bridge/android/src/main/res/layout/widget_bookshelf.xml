          <TextView android:id="@+id/title_3_1" style="@style/BookshelfWidgetTitle" />
          <FrameLayout style="@style/BookshelfWidgetCellSpacer" />
      </LinearLayout>
      <LinearLayout android:id="@+id/cell_3_2" style="@style/BookshelfWidgetCell"
        android:layout_row="3" android:layout_column="2">
          <FrameLayout style="@style/BookshelfWidgetCellSpacer" />
          <ImageView android:id="@+id/cover_3_2" style="@style/BookshelfWidgetCover" />
          <ImageView android:id="@+id/cover_title_3_2" style="@style/BookshelfWidgetCoverWithTitle" />
