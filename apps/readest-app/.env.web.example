NEXT_PUBLIC_APP_PLATFORM=web
AI_GATEWAY_API_KEY=your_key_here
NEXT_PUBLIC_AI_GATEWAY_API_KEY=your_key_here
# Readest Voice (premium TTS). RunPod settings live on the readest-voice
# Worker (readest/readest-voice, service/), reached through the READEST_VOICE
# service binding in wrangler.toml. Without the binding or the catalog the
# /api/tts/readest routes answer 503 and the engine hides (kill switch).
# Voice catalog on the Readest CDN, one file per worker version
# (https://cdn.readest.com/readest-voice/catalog-<version>.json).
READEST_TTS_CATALOG_URL=
# Optional: fixed daily TTS character quota for every plan (nonzero).
TTS_FIXED_QUOTA=
# Local development against the worker's Docker emulator:
# READEST_TTS_CATALOG_URL=http://localhost:8801/catalog.json
