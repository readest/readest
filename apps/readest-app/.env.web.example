NEXT_PUBLIC_APP_PLATFORM=web
AI_GATEWAY_API_KEY=your_key_here
NEXT_PUBLIC_AI_GATEWAY_API_KEY=your_key_here
# Readest Voice (self-hosted premium TTS on RunPod Serverless). Unset either of
# the first two to disable it: the /api/tts/readest routes answer 503 and the
# engine hides (kill switch).
RUNPOD_API_KEY=
RUNPOD_TTS_ENDPOINT_ID=
# Voice catalog exported by the TTS worker (scripts/export_catalog.py).
READEST_TTS_CATALOG_URL=
# Optional: fixed daily TTS character quota for every plan (nonzero).
TTS_FIXED_QUOTA=
# Local development against the worker's Docker emulator:
# RUNPOD_API_BASE=http://localhost:8801
# RUNPOD_TTS_ENDPOINT_ID=local
# READEST_TTS_CATALOG_URL=http://localhost:8801/catalog.json
