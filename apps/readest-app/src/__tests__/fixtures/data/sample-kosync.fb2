<?xml version="1.0" encoding="utf-8"?>
<FictionBook xmlns="http://www.gribuser.ru/xml/fictionbook/2.0" xmlns:l="http://www.w3.org/1999/xlink">
  <description>
    <title-info>
      <genre>prose</genre>
      <author><first-name>Test</first-name><last-name>Author</last-name></author>
      <book-title>KOSync FB2 Sample</book-title>
      <lang>en</lang>
    </title-info>
    <document-info>
      <author><nickname>readest</nickname></author>
      <id>readest-kosync-fb2-sample</id>
      <version>1.0</version>
    </document-info>
  </description>
  <body>
    <image l:href="#cover.png"/>
    <title>
      <p>KOSync FB2 Sample</p>
      <empty-line/>
      <p>A book for position sync</p>
    </title>
    <epigraph>
      <p>Words before the first chapter.</p>
      <text-author>Someone Wise</text-author>
    </epigraph>
    <section>
      <title><p>Chapter One</p></title>
      <epigraph>
        <p>An epigraph inside the chapter.</p>
        <text-author>Another Author</text-author>
      </epigraph>
      <p>The first paragraph of chapter one.</p>
      <p>Plain <emphasis>italic</emphasis> and <strong>bold</strong> words with a note<a l:href="#n1" type="note">[1]</a> after them.</p>
      <empty-line/>
      <subtitle>A subtitle</subtitle>
      <p>The third paragraph of chapter one.</p>
    </section>
    <section>
      <title><p>Chapter Two</p></title>
      <section>
        <title><p>Part A</p></title>
        <p>Nested section text, part A.</p>
        <poem>
          <stanza>
            <v>First line of the verse</v>
            <v>Second line of the verse</v>
          </stanza>
          <stanza>
            <v>Third line of the verse</v>
          </stanza>
          <text-author>The Poet</text-author>
        </poem>
      </section>
      <section>
        <title><p>Part B</p></title>
        <cite>
          <p>A quotation in part B.</p>
          <text-author>Quoted Person</text-author>
        </cite>
        <p>Nested section text, part B<a l:href="#n2" type="note">[2]</a>.</p>
      </section>
    </section>
    <section>
      <title><p>Chapter Three</p></title>
      <p>The last chapter has a single paragraph.</p>
    </section>
  </body>
  <body name="notes">
    <title><p>Notes</p></title>
    <section id="n1">
      <title><p>1</p></title>
      <p>The first note.</p>
    </section>
    <section id="n2">
      <title><p>2</p></title>
      <p>The second note.</p>
    </section>
  </body>
