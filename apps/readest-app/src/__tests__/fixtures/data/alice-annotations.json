      "note": "",
      "createdAt": 1784388968433,
      "updatedAt": 1785053604577,
      "text": "Alice remained looking thoughtfully at the mushroom for a\nminute, trying to make out which were the two sides of it;",
      "style": "highlight",
      "color": "yellow",
      "xpointer0": "/body/DocFragment[8]/body/div/div/div/p[75]/text().0",
      "xpointer1": "/body/DocFragment[8]/body/div/div/div/p[75]/text().116"
    },
