      "type": "annotation",
      "cfi": "epubcfi(/6/18!/4/2/2[chapter_468]/4/144/2/4/2,/1:0,/1:21)",
      "note": "",
      "createdAt": 1744878126845,
      "updatedAt": 1785053606346,
      "text": "“首先，”猫说，“狗不会生气的。你同意吗？",
      "style": "squiggly",
      "color": "green",
      "xpointer0": "/body/DocFragment[9]/body/div/div/div/p[72]",
      "xpointer1": "/body/DocFragment[9]/body/div/div/div/p[72]"
    },
