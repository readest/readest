      "type": "annotation",
      "cfi": "epubcfi(/6/30!/4/2/2[chapter_480]/4,/64/1:112,/66/1:37)",
      "note": "",
      "createdAt": 1775666332346,
      "updatedAt": 1785053608583,
      "text": " else you’d have\nsigned your name like an honest man.”\nThere was a general clapping of hands",
      "style": "highlight",
      "color": "yellow",
      "xpointer0": "/body/DocFragment[15]/body/div/div/div/p[32]/text().112",
      "xpointer1": "/body/DocFragment[15]/body/div/div/div/p[33]/text().37"
