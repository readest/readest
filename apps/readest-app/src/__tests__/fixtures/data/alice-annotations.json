      "note": "",
      "createdAt": 1772248819380,
      "updatedAt": 1785053612890,
      "text": "“But I don’t want to go among mad people,” Alice remarked.",
      "style": "underline",
      "color": "yellow",
      "xpointer0": "/body/DocFragment[9]/body/div/div/div/p[67]/text()[1].0",
      "xpointer1": "/body/DocFragment[9]/body/div/div/div/p[67]/text()[1].58"
    },
    {
