      "note": "",
      "createdAt": 1773921678995,
      "updatedAt": 1785053612889,
      "text": "Come, we shall have some fun now!” thought Alice.",
      "style": "highlight",
      "color": "yellow",
      "xpointer0": "/body/DocFragment[10]/body/div[2]/div/div/p[12]/text()[1].1",
      "xpointer1": "/body/DocFragment[10]/body/div[2]/div/div/p[12]/text()[1].50"
