      "createdAt": 1774840580608,
      "updatedAt": 1785053604577,
      "text": "The Mock Turtle sighed deeply, and drew the back of one flapper\nacross his eyes",
      "style": "highlight",
      "color": "yellow",
      "xpointer0": "/body/DocFragment[13]/body/div/div/div/p[1]/text().0",
