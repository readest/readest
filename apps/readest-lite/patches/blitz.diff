diff -ruN blitz/packages/blitz-dom/src/layout/columns.rs blitz/packages/blitz-dom/src/layout/columns.rs
--- blitz/packages/blitz-dom/src/layout/columns.rs
+++ blitz/packages/blitz-dom/src/layout/columns.rs
@@ -0,0 +1,275 @@
+//! Columns of the root element: CSS multi-column with `column-fill: auto` and a definite height,
+//! as foliate-js's paginator styles an EPUB section (one column per page, the columns overflowing
+//! to the right, the iframe as wide as all of them).
+//!
+//! The root's content is laid out once as a single column of the content-box width. After
+//! layout it is cut into column slices at line boundaries; paint, element rects and hit testing
+//! then map between that single-column flow and the columns: slice `i` (`start..end` of the
+//! flow) is shown `i * stride` to the right and `start` higher up. Nothing is laid out again to
+//! turn a page. Only the root element is supported, and break-* properties are not honoured
+//! (Stylo parses them only for Gecko).
+
+use crate::{BaseDocument, BoundingRect, Node, NodeId};
+use style::values::computed::length::NonNegativeLengthPercentageOrNormal;
+use style::values::generics::length::GenericLengthPercentageOrNormal;
+
+/// The root element's columns, in CSS px.
+#[derive(Clone, Debug)]
+pub struct Columns {
+    /// The root element.
+    pub root: NodeId,
+    /// The root's border-box origin in document coordinates.
+    pub origin: (f32, f32),
+    /// The content box's offset from the border-box origin.
+    pub content_left: f32,
+    pub content_top: f32,
+    /// Column width (the content-box width) and the distance between column starts.
+    pub width: f32,
+    pub gap: f32,
+    pub stride: f32,
+    /// The flow's `[start, end)` shown in each column, in content-box coordinates.
+    pub slices: Vec<(f32, f32)>,
+}
+
+const FAR: f32 = 1.0e7;
+
+impl Columns {
+    /// The part of the flow column `i` shows, open-ended before the first and after the last.
+    pub fn visible_slice(&self, i: usize) -> (f32, f32) {
+        let (start, end) = self.slices[i];
+        let start = if i == 0 { -FAR } else { start };
+        let end = if i + 1 == self.slices.len() { FAR } else { end };
+        (start, end)
+    }
+
+    /// Where column `i`'s content is painted relative to the flow: `(dx, dy)`.
+    pub fn offset(&self, i: usize) -> (f32, f32) {
+        (i as f32 * self.stride, -self.slices[i].0)
+    }
+
+    /// The column at `x` (root border-box coordinates), clamped to the columns there are.
+    pub fn column_at_x(&self, x: f32) -> usize {
+        let i = ((x - self.content_left + self.gap / 2.0) / self.stride).floor();
+        (i.max(0.0) as usize).min(self.slices.len() - 1)
+    }
+
+    /// A point in root border-box coordinates as painted -> the same point in the flow.
+    pub fn to_flow(&self, x: f32, y: f32) -> (f32, f32) {
+        let (dx, dy) = self.offset(self.column_at_x(x));
+        (x - dx, y - dy)
+    }
+
+    /// A rect of the flow (document coordinates) as the fragments the columns paint.
+    pub fn fragments(&self, rect: BoundingRect) -> Vec<BoundingRect> {
+        let base = f64::from(self.origin.1 + self.content_top);
+        let top = rect.y - base;
+        let bottom = top + rect.height;
+        let mut out = Vec::new();
+        for i in 0..self.slices.len() {
+            let (start, end) = self.visible_slice(i);
+            let (start, end) = (f64::from(start), f64::from(end));
+            let hit = if rect.height > 0.0 {
+                top < end && bottom > start
+            } else {
+                top >= start && top < end
+            };
+            if !hit {
+                continue;
+            }
+            let (dx, dy) = self.offset(i);
+            let (t, b) = (top.max(start), bottom.min(end));
+            out.push(BoundingRect {
+                x: rect.x + f64::from(dx),
+                y: base + t + f64::from(dy),
+                width: rect.width,
+                height: b - t,
+            });
+        }
+        if out.is_empty() {
+            out.push(rect);
+        }
+        out
+    }
+}
+
+/// Pages from boxes `(top, bottom)` of a flow `content_height` tall: a page ends at the top of
+/// the first box that would not fit, unless nothing is on the page yet; a box taller than a page
+/// is sliced, except that a page holding only that box crops up to `SLACK` px of it (the strut
+/// under a page-tall image). Margins after the last box make no page.
+pub(crate) fn paginate(
+    content_height: f32,
+    mut boxes: Vec<(f32, f32)>,
+    page: f32,
+) -> Vec<(f32, f32)> {
+    const SLACK: f32 = 16.0;
+    boxes.sort_by(|a, b| a.0.total_cmp(&b.0));
+    let mut pages = Vec::new();
+    let (mut start, mut filled, mut last, mut limit) = (0.0f32, false, 0.0f32, page);
+    for (top, bottom) in boxes {
+        last = last.max(bottom);
+        if bottom - start <= limit {
+            filled = true;
+            continue;
+        }
+        if !filled && bottom - start - page <= SLACK {
+            limit = bottom - start;
+            filled = true;
+            continue;
+        }
+        let end = if filled && top > start {
+            top
+        } else {
+            start + page
+        };
+        pages.push((start, end));
+        start = end;
+        limit = page;
+        while bottom - start > page {
+            pages.push((start, start + page));
+            start += page;
+        }
+        filled = bottom > start;
+    }
+    if last > start + SLACK || pages.is_empty() {
+        pages.push((start, content_height.max(start)));
+    }
+    pages
+}
+
+impl BaseDocument {
+    /// Recomputes the root element's columns (after layout).
+    pub(crate) fn update_columns(&mut self) {
+        let columns = self.compute_columns();
+        self.nodes.columns = columns;
+    }
+
+    fn compute_columns(&self) -> Option<Columns> {
+        let root = self.try_root_element()?;
+        let style = root.primary_styles()?;
+        let column = style.get_column();
+        if column.column_width.is_auto() && column.column_count.is_auto() {
+            return None;
+        }
+        if style.get_position().height.is_auto() {
+            return None;
+        }
+        let layout = root.final_layout();
+        let content_left = layout.border.left + layout.padding.left;
+        let content_top = layout.border.top + layout.padding.top;
+        let width = layout.size.width - content_left - layout.border.right - layout.padding.right;
+        let page = layout.size.height - content_top - layout.border.bottom - layout.padding.bottom;
+        if width <= 0.0 || page <= 1.0 {
+            return None;
+        }
+        let gap = match &style.get_position().column_gap {
+            NonNegativeLengthPercentageOrNormal::Normal => {
+                style.get_font().font_size.computed_size().px()
+            }
+            GenericLengthPercentageOrNormal::LengthPercentage(lp) => {
+                lp.0.resolve(style::values::computed::Length::new(width))
+                    .px()
+            }
+        };
+        let origin = root.absolute_position(0.0, 0.0);
+        let top = origin.y + content_top;
+
+        // Line boxes and replaced boxes of the flow, in content-box coordinates.
+        let scale = self.viewport.scale();
+        let mut boxes = Vec::new();
+        let mut stack: Vec<&Node> = root.children.iter().map(|&id| &self.nodes[id]).collect();
+        while let Some(node) = stack.pop() {
+            if let Some(el) = node.element_data() {
+                let l = node.final_layout();
+                let y = node.absolute_position(0.0, 0.0).y - top;
+                if let Some(text) = el
+                    .inline_layout_data
+                    .as_ref()
+                    .filter(|_| node.flags.is_inline_root())
+                {
+                    let lines_top = y + l.border.top + l.padding.top + text.block_offset;
+                    for line in text.layout.lines() {
+                        let m = line.metrics();
+                        boxes.push((
+                            lines_top + m.block_min_coord / scale,
+                            lines_top + m.block_max_coord / scale,
+                        ));
+                    }
+                } else if el.image_data().is_some() {
+                    boxes.push((y, y + l.size.height));
+                }
+            }
+            stack.extend(node.children.iter().map(|&id| &self.nodes[id]));
+        }
+        let flow_height = boxes.iter().map(|b| b.1).fold(
+            layout.scrollable_overflow_rect.bottom() - content_top,
+            f32::max,
+        );
+        let slices = paginate(flow_height, boxes, page);
+        Some(Columns {
+            root: root.id,
+            origin: (origin.x, origin.y),
+            content_left,
+            content_top,
+            width,
+            gap,
+            stride: width + gap,
+            slices,
+        })
+    }
+
+    /// `rect` (document coordinates of the flow) as painted, for a node in the root's columns.
+    pub(crate) fn column_fragments(
+        &self,
+        node_id: NodeId,
+        rect: BoundingRect,
+    ) -> Vec<BoundingRect> {
+        match self.nodes.columns() {
+            Some(c) if in_columns(self, c, node_id) => c.fragments(rect),
+            _ => vec![rect],
+        }
+    }
+}
+
+/// Whether `node_id` is laid out in the columns: a descendant of their root.
+fn in_columns(doc: &BaseDocument, columns: &Columns, node_id: NodeId) -> bool {
+    let mut current = doc.nodes.get(node_id).and_then(|n| n.parent);
+    while let Some(id) = current {
+        if id == columns.root {
+            return true;
+        }
+        current = doc.nodes.get(id).and_then(|n| n.parent);
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::paginate;
+
+    #[test]
+    fn lines_are_cut_at_the_first_line_that_does_not_fit() {
+        let lines = (0..5)
+            .map(|i| (i as f32 * 20.0, i as f32 * 20.0 + 20.0))
+            .collect();
+        assert_eq!(
+            paginate(100.0, lines, 50.0),
+            [(0.0, 40.0), (40.0, 80.0), (80.0, 100.0)]
+        );
+    }
+
+    #[test]
+    fn a_page_tall_image_with_its_strut_is_one_page() {
+        assert_eq!(
+            paginate(615.0, vec![(8.0, 607.2), (8.0, 603.0)], 595.0),
+            [(0.0, 615.0)]
+        );
+    }
+
+    #[test]
+    fn a_box_taller_than_a_page_is_sliced() {
+        assert_eq!(
+            paginate(1300.0, vec![(10.0, 1300.0)], 595.0),
+            [(0.0, 595.0), (595.0, 1190.0), (1190.0, 1300.0)]
+        );
+    }
+}
