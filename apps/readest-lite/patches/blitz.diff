+#[cfg(test)]
+mod has_selector_tests {
+    use crate::{HtmlDocument, HtmlProvider};
+    use blitz_dom::DocumentConfig;
+    use std::sync::Arc;
+
+    fn page(css: &str, body: &str) -> HtmlDocument {
+        let config = DocumentConfig {
+            html_parser_provider: Some(Arc::new(HtmlProvider)),
+            ..Default::default()
+        };
+        let mut doc = HtmlDocument::from_html(
+            &format!("<html><head><style>{css}</style></head><body>{body}</body></html>"),
+            config,
+        );
+        doc.resolve(0.0);
+        doc
+    }
+
+    fn hidden(doc: &HtmlDocument, id: &str) -> bool {
+        let node = doc.get_node(doc.get_element_by_id(id).unwrap()).unwrap();
+        node.primary_styles().unwrap().get_box().display.is_none()
+    }
+
+    #[test]
+    fn a_rule_whose_selector_list_has_has_applies() {
+        // Readest's book paragraph rule: a selector list that can't be parsed is dropped whole,
+        // so without `:has()` its `p` lost the rule too.
+        let doc = page(
+            "p, blockquote, div:not(:has(:not(b, i))) { display: none }",
+            "<p id='p'>text</p><div id='plain'><b>bold</b> text</div><div id='mixed'><span>x</span></div>",
+        );
+        assert!(hidden(&doc, "p"), "p");
+        assert!(hidden(&doc, "plain"), "a div holding only <b>");
+        assert!(!hidden(&doc, "mixed"), "a div holding a <span>");
+    }
+
+    #[test]
+    fn has_follows_a_change_of_children() {
+        let mut doc = page("div:has(> b) { display: none }", "<div id='d'><span>x</span></div>");
+        assert!(!hidden(&doc, "d"));
+        let d = doc.get_element_by_id("d").unwrap();
+        doc.mutate().set_inner_html(d, "<b>x</b>");
+        doc.resolve(0.0);
+        assert!(hidden(&doc, "d"), "after a <b> child is added");
+        doc.mutate().set_inner_html(d, "<i>x</i>");
+        doc.resolve(0.0);
+        assert!(!hidden(&doc, "d"), "after it is removed");
+    }
+
+    #[test]
+    fn has_follows_a_class_change_deep_below() {
+        // daisyUI's `:root:has(.modal-open)`: a dialog deep in the page changes the root's style.
+        let mut doc = page(
+            ":root:has(.open) #flag { display: none }",
+            "<div id='flag'>f</div><div><section><p id='deep'>x</p></section></div>",
+        );
+        assert!(!hidden(&doc, "flag"));
+        let deep = doc.get_element_by_id("deep").unwrap();
+        let class = html5ever::QualName::new(None, html5ever::ns!(), html5ever::local_name!("class"));
+        doc.mutate().set_attribute(deep, class.clone(), "open");
+        doc.resolve(0.0);
+        assert!(hidden(&doc, "flag"), "after a descendant gains the class");
+        doc.mutate().clear_attribute(deep, class);
+        doc.resolve(0.0);
+        assert!(!hidden(&doc, "flag"), "after it loses it");
+    }
+
+    #[test]
+    fn has_follows_a_state_change_below() {
+        let mut doc = page(
+            "div:has(:checked) { display: none }",
+            "<div id='d'><input type='radio' name='r' id='a'><input type='radio' name='r'></div>",
+        );
+        assert!(!hidden(&doc, "d"));
+        let a = doc.get_element_by_id("a").unwrap();
+        doc.toggle_radio("r".into(), a);
