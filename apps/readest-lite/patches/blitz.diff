+#[cfg(test)]
+mod tests {
+    use crate::{BaseDocument, DocumentConfig, NodeId, qual_name};
+
+    /// `<html><body><div style="width:50px; height:20px"></div></body></html>`, resolved.
+    fn page() -> (BaseDocument, NodeId) {
+        let mut doc = BaseDocument::new(DocumentConfig::default());
+        let root = doc.root_node().id;
+        let mut m = doc.mutate();
+        let html = m.create_element(qual_name!("html", html), vec![]);
+        let body = m.create_element(qual_name!("body", html), vec![]);
+        let div = m.create_element(qual_name!("div", html), vec![]);
+        m.set_attribute(div, qual_name!("style"), "width:50px; height:20px");
+        m.append_children(body, &[div]);
+        m.append_children(html, &[body]);
+        m.append_children(root, &[html]);
+        drop(m);
+        doc.resolve(0.0);
+        (doc, div)
+    }
+
+    fn width(doc: &BaseDocument, id: NodeId) -> f32 {
+        doc.get_client_bounding_rect(id).unwrap().width as f32
+    }
+
+    #[test]
+    fn a_resolve_with_nothing_changed_lays_out_nothing() {
+        let (mut doc, div) = page();
+        let generation = doc.nodes.geometry_generation();
+        doc.resolve(0.0);
+        doc.resolve(0.0);
+        assert_eq!(doc.nodes.geometry_generation(), generation);
+        assert_eq!(width(&doc, div), 50.0);
+    }
+
+    #[test]
+    fn a_change_that_changes_no_style_leaves_the_document_clean() {
+        // a class that no rule matches: restyled, nothing damaged
+        let (mut doc, div) = page();
+        doc.mutate().set_attribute(div, qual_name!("class"), "unmatched");
+        doc.resolve(0.0);
+        let generation = doc.nodes.geometry_generation();
+        doc.resolve(0.0);
+        assert_eq!(doc.nodes.geometry_generation(), generation);
+    }
+
+    #[test]
+    fn changes_after_a_clean_resolve_are_laid_out() {
+        let (mut doc, div) = page();
+        doc.resolve(0.0);
+        doc.mutate()
+            .set_attribute(div, qual_name!("style"), "width:80px; height:20px");
+        doc.resolve(0.0);
+        assert_eq!(width(&doc, div), 80.0);
+        // a new stylesheet marks no node; it changes the stylist
+        let body = doc.get_node(div).unwrap().parent.unwrap();
+        let mut m = doc.mutate();
+        let style = m.create_element(qual_name!("style", html), vec![]);
+        let text = m.create_text_node("div { width: 30px !important }");
+        m.append_children(style, &[text]);
+        m.append_children(body, &[style]);
+        drop(m);
+        doc.resolve(0.0);
+        assert_eq!(width(&doc, div), 30.0);
+    }
+}
