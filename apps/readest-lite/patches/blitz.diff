+/// A glyph run's content area in the layout's units: its font's ascent above the baseline and
+/// descent below it, each rounded to a whole pixel as browsers do. CSSOM View gives this, not the
+/// line box, as the height of an inline box and of a text range's rects.
+pub(crate) fn content_area<B: parley::Brush>(run: &parley::GlyphRun<'_, B>) -> (f32, f32) {
+    let m = run.run().font_metrics();
+    (run.baseline() - m.ascent.round(), run.baseline() + m.descent.round())
+}
+
+/// A line's inline extent in the layout's units, without the white space at its end (CSS Text 3
+/// §4.1.3: removed, or hanging, it has no box). Parley keeps that space in the line's last glyph
+/// run and reports its width as `hanging_advance`, at the right of an LTR paragraph's lines and
+/// the left of an RTL one's.
+pub(crate) fn line_extent<B: parley::Brush>(layout: &parley::Layout<B>, line: &parley::Line<'_, B>) -> (f32, f32) {
+    let (mut lo, mut hi) = (f32::INFINITY, f32::NEG_INFINITY);
+    for item in line.items() {
+        let (x0, x1) = match item {
+            parley::PositionedLayoutItem::GlyphRun(r) => (r.offset(), r.offset() + r.advance()),
+            parley::PositionedLayoutItem::InlineBox(b) => (b.x, b.x + b.width),
+        };
+        (lo, hi) = (lo.min(x0), hi.max(x1));
+    }
+    let hang = line.metrics().hanging_advance;
+    if layout.is_rtl() { (lo + hang, hi) } else { (lo, hi - hang) }
+}
