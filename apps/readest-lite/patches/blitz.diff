+#[cfg(test)]
+mod inner_html_tests {
+    use crate::{HtmlDocument, HtmlProvider};
+    use blitz_dom::{DocumentConfig, NodeId, RestyleHint};
+    use std::sync::Arc;
+
+    fn page() -> (HtmlDocument, NodeId, NodeId) {
+        let config = DocumentConfig {
+            html_parser_provider: Some(Arc::new(HtmlProvider)),
+            ..Default::default()
+        };
+        let mut doc = HtmlDocument::from_html(
+            // daisyUI's `.stack` rule: `:is()` defeats the ancestor filter, so `:first-child` is
+            // tested on every element and flags every parent, the document node too. A change
+            // to the document node's child list then restyles every element.
+            "<html><head><style>:is(.stack, .stack.stack-bottom) > :first-child { order: 1 }</style></head>\
+             <body><p id='other'>text</p><div id='target'><span>old</span></div></body></html>",
+            config,
+        );
+        doc.resolve(0.0);
+        let other = doc.get_element_by_id("other").unwrap();
+        let target = doc.get_element_by_id("target").unwrap();
+        (doc, other, target)
+    }
+
+    #[test]
+    fn setting_inner_html_restyles_only_the_element_it_changes() {
+        for html in ["", "<b>new</b>"] {
+            let (mut doc, _, target) = page();
+            doc.mutate().set_inner_html(target, html);
+            // What the next resolve will restyle: not the whole document.
+            let root = doc.root_element();
+            let hint = root.try_stylo_element_data().unwrap().get().unwrap().hint;
+            assert!(
+                !hint.contains(RestyleHint::RESTYLE_DESCENDANTS),
+                "innerHTML = {html:?}: {hint:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn inner_html_replaces_the_children_and_leaves_the_document_alone() {
+        let (mut doc, _, target) = page();
+        let root = doc.root_node().id;
+        let root_children = doc.get_node(root).unwrap().children.clone();
+        doc.mutate().set_inner_html(target, "<b>new</b> text");
+        doc.resolve(0.0);
+        assert_eq!(doc.get_node(root).unwrap().children, root_children);
+        let mut out = String::new();
+        let node = doc.get_node(target).unwrap();
+        for &child in &node.children {
+            out.push_str(&doc.get_node(child).unwrap().outer_html());
+        }
+        assert_eq!(out, "<b>new</b> text");
+    }
