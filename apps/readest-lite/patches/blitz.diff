+#[cfg(test)]
+mod inline_box_tests {
+    use crate::{HtmlDocument, HtmlProvider};
+    use blitz_dom::DocumentConfig;
+    use blitz_traits::shell::{ColorScheme, Viewport};
+    use std::sync::Arc;
+
+    // A tall line: the font's content area is far smaller than the line box.
+    const PAGE: &str = "<html><body style='margin:0'>\
+        <p id='p' style='margin:0;font-size:20px;line-height:100px'>a <span id='s'>word</span> b<span id='e'></span>c</p>\
+        </body></html>";
+
+    fn page() -> HtmlDocument {
+        let config = DocumentConfig {
+            html_parser_provider: Some(Arc::new(HtmlProvider)),
+            viewport: Some(Viewport::new(800, 600, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        };
+        let mut doc = HtmlDocument::from_html(PAGE, config);
+        doc.resolve(0.0);
+        doc
+    }
+
+    // CSSOM View: an inline box's border box is its font's content area (ascent + descent,
+    // centred in the line by the half-leading), not the line box, as in browsers.
+    fn assert_content_area(what: &str, y: f64, height: f64) {
+        assert!((15.0..40.0).contains(&height), "{what}: height {height}, the line box is 100");
+        let mid = y + height / 2.0;
+        assert!((30.0..70.0).contains(&mid), "{what}: middle at {mid}, outside the line's middle");
+        assert_eq!(height, height.round(), "{what}: ascent and descent are whole pixels");
+    }
+
+    #[test]
+    fn an_inline_element_box_is_its_font_content_area() {
+        let doc = page();
+        let span = doc.get_element_by_id("s").unwrap();
+        let r = doc.get_client_bounding_rect(span).unwrap();
+        assert_content_area("span", r.y, r.height);
+    }
+
+    #[test]
+    fn an_empty_inline_element_has_a_zero_width_box_where_it_sits() {
+        // As in browsers: foliate-js places page-break markers (empty spans) by their rects.
+        let doc = page();
+        let s = doc.get_client_bounding_rect(doc.get_element_by_id("s").unwrap()).unwrap();
+        let e = doc.get_client_bounding_rect(doc.get_element_by_id("e").unwrap()).unwrap();
+        assert_eq!(e.width, 0.0);
+        assert!(e.x > s.x + s.width, "after \"word b\": {e:?}, word at {s:?}");
+        assert_content_area("empty span", e.y, e.height);
+        // The text after it starts there: a span splitting the line doesn't shift range rects.
+        let e_node = doc.get_node(doc.get_element_by_id("e").unwrap()).unwrap();
+        let p = doc.get_node(e_node.parent.unwrap()).unwrap();
+        let c = *p.children.last().unwrap();
+        let rects = doc.text_rects(c, 0, 1);
+        assert_eq!(rects.len(), 1);
+        assert!((rects[0].x - e.x).abs() < 0.5 && rects[0].width < 20.0, "{rects:?}, span at {e:?}");
+    }
+
+    #[test]
+    fn a_text_range_box_is_its_font_content_area() {
+        let doc = page();
+        let span = doc.get_element_by_id("s").unwrap();
+        let text = doc.get_node(span).unwrap().children[0];
+        let rects = doc.text_rects(text, 0, 4);
+        assert_eq!(rects.len(), 1);
+        assert_content_area("range", rects[0].y, rects[0].height);
+    }
+
+    #[test]
+    fn the_space_removed_at_a_line_end_has_no_box() {
+        // "aaa bbb" wraps after "aaa ": that line's piece is as wide as "aaa" alone, as in
+        // browsers (the space at a line's end is removed), for the element and for a range.
+        let config = DocumentConfig {
+            html_parser_provider: Some(Arc::new(HtmlProvider)),
+            viewport: Some(Viewport::new(800, 600, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        };
+        let mut doc = HtmlDocument::from_html(
+            "<html><body style='margin:0'><div style='width:60px;font-size:20px'>\
+             <span id='w'>aaa bbb</span><br><span id='a'>aaa</span></div></body></html>",
+            config,
+        );
+        doc.resolve(0.0);
+        let rects = |id| doc.node_client_rects(doc.get_element_by_id(id).unwrap());
+        let (w, a) = (rects("w"), rects("a"));
+        assert_eq!(w.len(), 2, "{w:?}");
+        assert_eq!(w[0].width, a[0].width, "the element: {w:?}, \"aaa\" {a:?}");
+        let text = doc.get_node(doc.get_element_by_id("w").unwrap()).unwrap().children[0];
+        let r = doc.text_rects(text, 0, 4);
+        assert_eq!(r[0].width, a[0].width, "the range \"aaa \": {r:?}");
+        // A range of only that space has no rects, as in browsers: foliate-js bisects a page's
+        // visible range with them, and ends it before the space.
+        assert_eq!(doc.text_rects(text, 3, 4), [], "the range \" \"");
+    }
+}
