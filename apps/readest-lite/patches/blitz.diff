+#[cfg(test)]
+mod column_tests {
+    use crate::{HtmlDocument, HtmlProvider};
+    use blitz_dom::DocumentConfig;
+    use blitz_traits::shell::{ColorScheme, Viewport};
+    use std::sync::Arc;
+
+    // foliate-js's paginator: columns on the root with a definite height.
+    fn page(font_size: u32, height: u32) -> HtmlDocument {
+        let paragraphs: String = (0..40).map(|i| format!("<p id='p{i}' style='margin:0'>line {i}</p>")).collect();
+        let html = format!(
+            "<html style='height:100vh;column-width:200px;column-gap:20px;column-fill:auto;padding:0;margin:0'>\
+             <body style='margin:0'><div id='d' style='font-size:{font_size}px'>{paragraphs}</div></body></html>"
+        );
+        let config = DocumentConfig {
+            html_parser_provider: Some(Arc::new(HtmlProvider)),
+            viewport: Some(Viewport::new(220, height, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        };
+        let mut doc = HtmlDocument::from_html(&html, config);
+        doc.resolve(0.0);
+        doc
+    }
+
+    fn last(doc: &HtmlDocument) -> (f64, f64) {
+        let r = doc.get_client_bounding_rect(doc.get_element_by_id("p39").unwrap()).unwrap();
+        (r.x, r.y)
+    }
+
+    #[test]
+    fn columns_follow_a_relayout_below_the_root() {
+        let mut doc = page(16, 300);
+        let d = doc.get_element_by_id("d").unwrap();
+        let style = html5ever::QualName::new(None, html5ever::ns!(), html5ever::local_name!("style"));
+        doc.mutate().set_attribute(d, style, "font-size:24px");
+        doc.resolve(0.0);
+        assert_eq!(last(&doc), last(&page(24, 300)));
+    }
+
+    #[test]
+    fn a_block_split_across_columns_has_a_rect_per_column_to_its_bottom() {
+        // 40 lines in 300 px columns: #d runs through several.
+        let doc = page(16, 300);
+        let d = doc.get_element_by_id("d").unwrap();
+        let rects = doc.node_client_rects(d);
+        let r: Vec<_> = rects.iter().map(|r| (r.x, r.y, r.y + r.height)).collect();
+        assert!(r.len() >= 3, "{r:?}");
+        // One piece per column, left to right; each but the last reaches its column's bottom,
+        // and the later ones start at its top.
+        let stride = r[1].0 - r[0].0;
+        for (i, piece) in r.iter().enumerate() {
+            assert_eq!((piece.0, piece.1), (i as f64 * stride, 0.0), "{r:?}");
+            if i + 1 < r.len() {
+                assert_eq!(piece.2, 300.0, "{r:?}");
+            }
+        }
+        let b = doc.get_client_bounding_rect(d).unwrap();
+        assert_eq!((b.x, b.y, b.height), (0.0, 0.0, 300.0), "the union");
+    }
+
+    // Paragraphs of `lines` 20 px lines in 100 px columns (5 lines each), `css` on the root.
+    fn lines(paragraphs: &[usize], css: &str) -> HtmlDocument {
+        let body: String = paragraphs
+            .iter()
+            .enumerate()
+            .map(|(i, &n)| format!("<p id='p{i}' style='margin:0'>{}</p>", vec!["a"; n].join("<br>")))
+            .collect();
+        let html = format!(
+            "<html style='height:100vh;column-width:200px;column-gap:20px;column-fill:auto;padding:0;margin:0;{css}'>\
+             <body style='margin:0;line-height:20px'>{body}</body></html>"
+        );
+        let config = DocumentConfig {
+            html_parser_provider: Some(Arc::new(HtmlProvider)),
+            viewport: Some(Viewport::new(220, 100, 1.0, ColorScheme::Light)),
+            ..Default::default()
+        };
+        let mut doc = HtmlDocument::from_html(&html, config);
+        doc.resolve(0.0);
+        doc
+    }
+
+    // The first piece of a paragraph: (x, y, height).
+    fn first(doc: &HtmlDocument, id: &str) -> (f64, f64, f64) {
+        let r = doc.node_client_rects(doc.get_element_by_id(id).unwrap())[0];
+        (r.x, r.y, r.height)
+    }
+
+    #[test]
+    fn a_paragraph_with_fewer_than_orphans_lines_at_a_column_bottom_moves_to_the_next() {
+        // 4 lines, then a paragraph whose first line alone would end the column.
+        assert_eq!(first(&lines(&[4, 3], ""), "p1"), (240.0, 0.0, 60.0));
+        assert_eq!(first(&lines(&[4, 3], "orphans:1"), "p1"), (0.0, 80.0, 20.0));
+    }
+
+    #[test]
+    fn a_column_breaks_early_to_leave_widows_lines_after_it() {
+        // 6 lines: 5 fit, which would leave 1 at the next column's top.
+        let rects = doc_rects(&lines(&[6], ""), "p0");
+        assert_eq!(rects, [(0.0, 0.0, 100.0), (240.0, 0.0, 40.0)], "4 lines, then 2");
+        assert_eq!(doc_rects(&lines(&[6], "widows:1"), "p0"), [(0.0, 0.0, 100.0), (240.0, 0.0, 20.0)]);
+    }
+
+    #[test]
+    fn orphans_win_when_orphans_and_widows_cannot_both_hold() {
+        // As in Chromium. A 6-line paragraph with orphans 4 and widows 3: 4 lines, then 2.
+        assert_eq!(
+            doc_rects(&lines(&[6], "orphans:4;widows:3"), "p0"),
+            [(0.0, 0.0, 100.0), (240.0, 0.0, 40.0)]
+        );
+        // 2 lines at a column's bottom, then 1 (Readest's novel, Chromium's break): with orphans
+        // and widows 2, the paragraph is not moved whole.
+        assert_eq!(first(&lines(&[3, 3], ""), "p1"), (0.0, 60.0, 40.0));
+    }
+
+    #[test]
+    fn columns_are_as_wide_as_the_unrounded_content_box() {
+        // foliate-js's paginator: a fractional side padding, one column per root width.
+        let css = "width:464px;box-sizing:border-box;padding:0 16.2105px;column-width:399px;column-gap:32.4211px";
+        let (x, _, _) = first(&lines(&[5, 5], css), "p1");
+        assert!((x - (464.0 + 16.2105)).abs() < 0.01, "the second column at {x}, not 480.21");
+    }
+
+    fn doc_rects(doc: &HtmlDocument, id: &str) -> Vec<(f64, f64, f64)> {
+        doc.node_client_rects(doc.get_element_by_id(id).unwrap())
+            .iter()
+            .map(|r| (r.x, r.y, r.height))
+            .collect()
+    }
+
+    #[test]
+    fn columns_follow_a_viewport_change() {
+        let mut doc = page(16, 300);
+        doc.set_viewport(Viewport::new(220, 500, 1.0, ColorScheme::Light));
+        doc.resolve(0.0);
+        let mut fresh = page(16, 500);
+        fresh.resolve(0.0);
+        assert_eq!(last(&doc), last(&fresh));
+    }
+}
