+                let top = origin.y + layout.location.y + layout.border.top;
+                let right = origin.x + layout.location.x + layout.size.width - layout.border.right;
+                let bottom = origin.y + layout.location.y + layout.size.height - layout.border.bottom;
+                let rect = Rect {
+                    left: if clip_x { left } else { -FAR },
+                    right: if clip_x { right } else { FAR },
+                    top: if clip_y { top } else { -FAR },
+                    bottom: if clip_y { bottom } else { FAR },
+                };
+                clip = Some(match clip {
+                    None => rect,
+                    Some(c) => Rect {
+                        left: c.left.max(rect.left),
+                        right: c.right.min(rect.right),
+                        top: c.top.max(rect.top),
+                        bottom: c.bottom.min(rect.bottom),
+                    },
+                });
+            }
+        }
+        current = node.containing_block();
+    }
