+/// The clip, in the coordinates of `painter_id`'s border box (unscrolled), for a box painted by
+/// `painter_id` past static ancestors that clip their contents: the intersection of the padding
+/// boxes of the clipping boxes strictly between the two on `child_id`'s positioning chain, per
+/// axis (`overflow-x` clips only horizontally). `None` when none of them clips.
+pub fn lifted_clip_rect(tree: &NodeTree, painter_id: NodeId, child_id: NodeId) -> Option<Rect<f32>> {
+    use style::values::computed::{Contain, Overflow};
+
+    const FAR: f32 = 1.0e6;
+    let mut clip: Option<Rect<f32>> = None;
+    let mut current = tree[child_id].containing_block();
+    while let Some(id) = current {
+        if id == painter_id {
+            break;
+        }
+        let node = tree.get(id)?;
+        if let Some(style) = node.primary_styles() {
+            let box_style = style.get_box();
+            let paint = box_style.slow_clone_contain().contains(Contain::PAINT);
+            let clip_x = paint || !matches!(box_style.overflow_x, Overflow::Visible);
+            let clip_y = paint || !matches!(box_style.overflow_y, Overflow::Visible);
+            if clip_x || clip_y {
+                let origin = hoisted_child_position(tree, painter_id, id);
+                let layout = node.final_layout();
+                let left = origin.x + layout.location.x + layout.border.left;
+                let top = origin.y + layout.location.y + layout.border.top;
+                let right = origin.x + layout.location.x + layout.size.width - layout.border.right;
+                let bottom = origin.y + layout.location.y + layout.size.height - layout.border.bottom;
+                let rect = Rect {
+                    left: if clip_x { left } else { -FAR },
+                    right: if clip_x { right } else { FAR },
+                    top: if clip_y { top } else { -FAR },
+                    bottom: if clip_y { bottom } else { FAR },
+                };
+                clip = Some(match clip {
+                    None => rect,
+                    Some(c) => Rect {
+                        left: c.left.max(rect.left),
+                        right: c.right.min(rect.right),
+                        top: c.top.max(rect.top),
+                        bottom: c.bottom.min(rect.bottom),
+                    },
+                });
+            }
+        }
+        current = node.containing_block();
+    }
