diff -ruN rquickjs-sys/src/inlines/ptr_64.rs rquickjs-sys/src/inlines/ptr_64.rs
--- rquickjs-sys/src/inlines/ptr_64.rs
+++ rquickjs-sys/src/inlines/ptr_64.rs
@@ -10,12 +10,13 @@
 
 #[inline]
 pub unsafe fn JS_VALUE_GET_INT(v: JSValue) -> i32 {
-    v.u.int32
+    // QuickJS-NG 0.18: ints and bools live in the low half of `uint64`.
+    v.u.uint64 as i32
 }
 
 #[inline]
 pub unsafe fn JS_VALUE_GET_BOOL(v: JSValue) -> bool {
-    v.u.int32 != 0
+    v.u.uint64 as i32 != 0
 }
 
