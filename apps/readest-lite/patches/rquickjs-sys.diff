diff -ruN rquickjs-sys/quickjs/quickjs.c rquickjs-sys/quickjs/quickjs.c
--- rquickjs-sys/quickjs/quickjs.c
+++ rquickjs-sys/quickjs/quickjs.c
@@ -53489,7 +53489,15 @@
         h = 0;
         break;
     }
-    return h ^ ctx->hash_seed ^ hash32(tag);
+    h ^= ctx->hash_seed ^ hash32(tag);
+    /* The bucket is the hash's low bits, which the number and pointer hashes above leave zero for
+       small integers and aligned pointers: mix the high bits down (murmur3's finalizer). */
+    h ^= h >> 16;
+    h *= 0x85ebca6b;
+    h ^= h >> 13;
+    h *= 0xc2b2ae35;
+    h ^= h >> 16;
+    return h;
 }
 
 static JSMapRecord *map_find_record(JSContext *ctx, JSMapState *s,
diff -ruN rquickjs-sys/src/inlines/ptr_64.rs rquickjs-sys/src/inlines/ptr_64.rs
--- rquickjs-sys/src/inlines/ptr_64.rs
+++ rquickjs-sys/src/inlines/ptr_64.rs
@@ -10,12 +10,13 @@
 
 #[inline]
 pub unsafe fn JS_VALUE_GET_INT(v: JSValue) -> i32 {
-    v.u.int32
+    // QuickJS-NG 0.18: ints and bools live in the low half of `uint64`.
+    v.u.uint64 as i32
 }
 
 #[inline]
 pub unsafe fn JS_VALUE_GET_BOOL(v: JSValue) -> bool {
-    v.u.int32 != 0
+    v.u.uint64 as i32 != 0
 }
 
 #[inline]
@@ -31,7 +32,7 @@
 #[inline]
 pub const fn JS_MKVAL(tag: i32, val: i32) -> JSValue {
     JSValue {
-        u: JSValueUnion { int32: val },
+        u: JSValueUnion { uint64: val as u32 as u64 },
         tag: tag as _,
     }
 }
