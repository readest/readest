@@ -31,7 +32,7 @@
 #[inline]
 pub const fn JS_MKVAL(tag: i32, val: i32) -> JSValue {
     JSValue {
-        u: JSValueUnion { int32: val },
+        u: JSValueUnion { uint64: val as u32 as u64 },
         tag: tag as _,
     }
 }
