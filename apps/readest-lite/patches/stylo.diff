diff -ruN stylo/style/properties/longhands.toml stylo/style/properties/longhands.toml
--- stylo/style/properties/longhands.toml
+++ stylo/style/properties/longhands.toml
@@ -3961,6 +3961,28 @@
 type = "EmptyCells"
 initial = "computed::EmptyCells::Show"
 
+# Servo only: Blitz's root columns keep this many lines of a paragraph at a column's bottom
+# (orphans) and top (widows).
+[orphans]
+type = "Integer"
+initial = "2"
+struct = "inherited_text"
+engine = "servo"
+parse_method = "parse_positive"
+spec = "https://drafts.csswg.org/css-break/#widows-orphans"
+servo_restyle_damage = "rebuild_box"
+affects = "layout"
+
+[widows]
+type = "Integer"
+initial = "2"
+struct = "inherited_text"
+engine = "servo"
+parse_method = "parse_positive"
+spec = "https://drafts.csswg.org/css-break/#widows-orphans"
+servo_restyle_damage = "rebuild_box"
+affects = "layout"
+
 [hyphens]
 struct = "inherited_text"
 servo_pref = "layout.css.hyphens.enabled"
diff -ruN stylo/style/properties/shorthands.toml stylo/style/properties/shorthands.toml
--- stylo/style/properties/shorthands.toml
+++ stylo/style/properties/shorthands.toml
@@ -555,8 +555,8 @@
 spec = "https://compat.spec.whatwg.org/#the-webkit-text-stroke"
 derive_serialize = true
 
+# Servo too: Blitz clamps a block's lines (Tailwind's line-clamp-N sets this).
 [-webkit-line-clamp]
-engine = "gecko"
 flags = "IS_LEGACY_SHORTHAND ALLOWS_DISABLED_SUBPROPERTIES"
 sub_properties = ["line-clamp"]
 spec = "https://drafts.csswg.org/css-overflow-4/#webkit-line-clamp"
