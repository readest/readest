+/// The container's inner size as a basis for its items' percentage sizes: each axis only where that
+/// size is definite. A known main size derived from the container's own content is indefinite, and
+/// so is a known cross size the container was given without it being definite (the container
+/// was centred rather than stretched in its own line): percentages there behave as `auto`.
+fn percent_basis(constants: &AlgoConstants) -> Size<Option<f32>> {
+    let dir = constants.dir;
+    let size = constants.node_inner_size;
+    let size = if constants.known_main_size_is_definite { size } else { size.with_main(dir, None) };
+    if constants.has_definite_cross_size {
+        size
+    } else {
+        size.with_cross(dir, None)
+    }
+}
