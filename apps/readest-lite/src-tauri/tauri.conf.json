{
  "productName": "Readest Lite",
  "version": "0.1.0",
  "identifier": "com.bilingify.readest-lite",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**",
            "$APPDATA/**/*",
            "$APPCACHE/**/*",
            "$TEMP/**/*",
            "**/Readest/**/*"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
