msgid "Push selected books and their metadata into your Readest cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Wysyła wybrane książki i ich metadane do Twojej biblioteki Readest w chmurze. Ponowne wysłanie książki aktualizuje istniejący wpis zamiast tworzyć duplikat."

msgid "Not logged in."
msgstr "Nie zalogowano."

msgid "Include custom columns in pushed metadata"
msgstr "Dołącz własne kolumny do wysyłanych metadanych"

msgid "Only change this if you run a self-hosted Readest server."
msgstr "Zmień to tylko, jeśli korzystasz z własnego serwera Readest."

msgid "Logged in as %s."
msgstr "Zalogowano jako %s."

msgid "API server:"
msgstr "Serwer API:"

msgid "Use the Readest toolbar menu to log in or out."
msgstr "Użyj menu Readest na pasku narzędzi, aby się zalogować lub wylogować."

msgid "Push to Readest"
msgstr "Wyślij do Readest"

msgid "Push to Readest failed"
msgstr "Wysyłanie do Readest nie udało się"

msgid "Readest status"
msgstr "Stan Readest"

msgid "Readest status check failed"
msgstr "Sprawdzanie stanu Readest nie udało się"

msgid "Log in to Readest"
msgstr "Zaloguj się do Readest"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Hasło:"

msgid "Log in"
msgstr "Zaloguj się"

msgid "Logging in…"
msgstr "Logowanie…"

msgid "Waiting for the browser login to complete…"
msgstr "Oczekiwanie na zakończenie logowania w przeglądarce…"

msgid "Unknown"
msgstr "Nieznany"

msgid "Pushing %d book to your Readest library…"
msgid_plural "Pushing %d books to your Readest library…"
msgstr[0] "Wysyłanie %d książki do Twojej biblioteki Readest…"
msgstr[1] "Wysyłanie %d książek do Twojej biblioteki Readest…"
msgstr[2] "Wysyłanie %d książek do Twojej biblioteki Readest…"

msgid "Checking %d book against your Readest library…"
msgid_plural "Checking %d books against your Readest library…"
msgstr[0] "Sprawdzanie %d książki w Twojej bibliotece Readest…"
msgstr[1] "Sprawdzanie %d książek w Twojej bibliotece Readest…"
msgstr[2] "Sprawdzanie %d książek w Twojej bibliotece Readest…"

msgid "Or sign in with your browser:"
msgstr "Albo zaloguj się przez przeglądarkę:"

msgid "Please enter both email and password."
msgstr "Podaj zarówno e-mail, jak i hasło."

msgid "Login failed: the browser callback carried no session."
msgstr "Logowanie nie udało się: odpowiedź przeglądarki nie zawierała sesji."

msgid "Book"
msgstr "Książka"

msgid "Status"
msgstr "Stan"

msgid "Details"
msgstr "Szczegóły"

msgid "Canceling…"
msgstr "Anulowanie…"

msgid "Browser login timed out. Try again."
msgstr "Logowanie w przeglądarce przekroczyło czas. Spróbuj ponownie."

msgid "Login failed: %s"
msgstr "Logowanie nie udało się: %s"

msgid "Readest Login"
msgstr "Logowanie do Readest"

msgid "Completing login…"
msgstr "Kończenie logowania…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Logowanie zakończone. Możesz zamknąć tę kartę i wrócić do calibre."

msgid "Readest"
msgstr "Readest"

msgid "Push selected books and metadata to your Readest library"
msgstr "Wysyła wybrane książki i metadane do Twojej biblioteki Readest"

msgid "Select the books to push to Readest."
msgstr "Wybierz książki do wysłania do Readest."

msgid "Select the books to check against Readest."
msgstr "Wybierz książki do sprawdzenia w Readest."

msgid "No books selected"
msgstr "Nie wybrano żadnej książki"

msgid "Push selected books to Readest"
msgstr "Wyślij wybrane książki do Readest"

msgid "Check Readest status"
msgstr "Sprawdź stan Readest"

msgid "Log in to Readest…"
msgstr "Zaloguj się do Readest…"

msgid "Log out"
msgstr "Wyloguj się"

msgid "Customize plugin…"
msgstr "Dostosuj wtyczkę…"

msgid "Log out (%s)"
msgstr "Wyloguj się (%s)"

msgid "your Readest account"
msgstr "Twoje konto Readest"

msgid "Uploaded"
msgstr "Przesłana"

msgid "Replaced"
msgstr "Zastąpiona"

msgid "Updated"
msgstr "Zaktualizowana"

msgid "Up to date"
msgstr "Aktualna"

msgid "Failed"
msgstr "Nie udała się"

msgid "In Readest"
msgstr "W Readest"

msgid "Metadata differs"
msgstr "Metadane różnią się"

msgid "Out of date"
msgstr "Nieaktualna"

msgid "Not in Readest"
msgstr "Nie ma w Readest"

msgid "No Readest-supported format (EPUB, PDF, ...)"
msgstr "Brak formatu obsługiwanego przez Readest (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "Plik książki nie znajduje się w bibliotece calibre"

msgid "Nothing to push."
msgstr "Nic do wysłania."

msgid "Nothing to check."
msgstr "Nic do sprawdzenia."

msgid "Please log in to Readest first. (%s)"
msgstr "Najpierw zaloguj się do Readest. (%s)"

msgid "Could not reach Readest: %s"
msgstr "Nie udało się połączyć z Readest: %s"

msgid "Canceled."
msgstr "Anulowano."

msgid "Readest storage quota exceeded — push stopped."
msgstr "Przekroczono limit miejsca w Readest — wysyłanie przerwane."

msgid "Session expired — please log in again."
msgstr "Sesja wygasła — zaloguj się ponownie."

msgid "Login failed"
msgstr "Logowanie nie udało się"

msgid "Not logged in"
msgstr "Nie zalogowano"

msgid "Session expired, please log in again"
msgstr "Sesja wygasła, zaloguj się ponownie"

msgid "Not authenticated"
msgstr "Brak uwierzytelnienia"

msgid "Request failed (%s)"
msgstr "Żądanie nie powiodło się (%s)"

msgid "Upload failed (%s)"
msgstr "Przesyłanie nie powiodło się (%s)"

msgid "%d uploaded"
msgid_plural "%d uploaded"
msgstr[0] "%d przesłana"
msgstr[1] "%d przesłane"
msgstr[2] "%d przesłanych"

msgid "%d replaced"
msgid_plural "%d replaced"
msgstr[0] "%d zastąpiona"
msgstr[1] "%d zastąpione"
msgstr[2] "%d zastąpionych"

msgid "%d updated"
msgid_plural "%d updated"
msgstr[0] "%d zaktualizowana"
msgstr[1] "%d zaktualizowane"
msgstr[2] "%d zaktualizowanych"

msgid "%d up to date"
msgid_plural "%d up to date"
msgstr[0] "%d aktualna"
msgstr[1] "%d aktualne"
msgstr[2] "%d aktualnych"

msgid "%d failed"
msgid_plural "%d failed"
msgstr[0] "%d nieudana"
msgstr[1] "%d nieudane"
msgstr[2] "%d nieudanych"

msgid "%d in Readest"
msgid_plural "%d in Readest"
msgstr[0] "%d w Readest"
msgstr[1] "%d w Readest"
msgstr[2] "%d w Readest"

msgid "%d metadata differs"
msgid_plural "%d metadata differs"
msgstr[0] "%d z innymi metadanymi"
msgstr[1] "%d z innymi metadanymi"
msgstr[2] "%d z innymi metadanymi"

msgid "%d out of date"
msgid_plural "%d out of date"
msgstr[0] "%d nieaktualna"
msgstr[1] "%d nieaktualne"
msgstr[2] "%d nieaktualnych"

msgid "%d not in Readest"
msgid_plural "%d not in Readest"
msgstr[0] "%d nieobecna w Readest"
