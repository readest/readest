msgstr[1] "%d al día"

msgid "%d failed"
msgid_plural "%d failed"
msgstr[0] "%d fallido"
msgstr[1] "%d fallidos"

msgid "%d in Readest"
msgid_plural "%d in Readest"
msgstr[0] "%d en Readest"
msgstr[1] "%d en Readest"

msgid "%d metadata differs"
msgid_plural "%d metadata differs"
msgstr[0] "%d con metadatos diferentes"
msgstr[1] "%d con metadatos diferentes"

