msgid "Push selected books and their metadata into your Readest cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envíe los libros seleccionados y sus metadatos a su biblioteca en la nube de Readest. Al volver a enviar un libro se actualiza su entrada existente en lugar de crear un duplicado."

msgid "Not logged in."
msgstr "No ha iniciado sesión."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir columnas personalizadas en los metadatos enviados"

msgid "Only change this if you run a self-hosted Readest server."
msgstr "Cambie esto solo si utiliza un servidor Readest autoalojado."

msgid "Logged in as %s."
msgstr "Sesión iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Readest toolbar menu to log in or out."
msgstr "Use el menú Readest de la barra de herramientas para iniciar o cerrar sesión."

msgid "Push to Readest"
msgstr "Enviar a Readest"

msgid "Push to Readest failed"
msgstr "Error al enviar a Readest"

msgid "Readest status"
msgstr "Estado de Readest"

msgid "Readest status check failed"
msgstr "Error al comprobar el estado de Readest"

msgid "Log in to Readest"
msgstr "Iniciar sesión en Readest"

msgid "Email:"
msgstr "Correo electrónico:"

msgid "Password:"
msgstr "Contraseña:"

msgid "Log in"
msgstr "Iniciar sesión"

msgid "Logging in…"
msgstr "Iniciando sesión…"

msgid "Waiting for the browser login to complete…"
msgstr "Esperando que se complete el inicio de sesión en el navegador…"

msgid "Unknown"
msgstr "Desconocido"

msgid "Pushing %d book to your Readest library…"
msgid_plural "Pushing %d books to your Readest library…"
msgstr[0] "Enviando %d libro a su biblioteca Readest…"
msgstr[1] "Enviando %d libros a su biblioteca Readest…"

msgid "Checking %d book against your Readest library…"
msgid_plural "Checking %d books against your Readest library…"
msgstr[0] "Comprobando %d libro contra su biblioteca Readest…"
msgstr[1] "Comprobando %d libros contra su biblioteca Readest…"

msgid "Or sign in with your browser:"
msgstr "O inicie sesión con su navegador:"

msgid "Please enter both email and password."
msgstr "Introduzca el correo electrónico y la contraseña."

msgid "Login failed: the browser callback carried no session."
msgstr "Error de inicio de sesión: la respuesta del navegador no contenía ninguna sesión."

msgid "Book"
msgstr "Libro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalles"

msgid "Canceling…"
msgstr "Cancelando…"

msgid "Browser login timed out. Try again."
msgstr "El inicio de sesión en el navegador caducó. Inténtelo de nuevo."

msgid "Login failed: %s"
msgstr "Error de inicio de sesión: %s"

msgid "Readest Login"
msgstr "Inicio de sesión en Readest"

msgid "Completing login…"
msgstr "Completando el inicio de sesión…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Inicio de sesión completado. Puede cerrar esta pestaña y volver a calibre."

msgid "Readest"
msgstr "Readest"

msgid "Push selected books and metadata to your Readest library"
msgstr "Enviar los libros seleccionados y sus metadatos a su biblioteca Readest"

msgid "Select the books to push to Readest."
msgstr "Seleccione los libros que desea enviar a Readest."

msgid "Select the books to check against Readest."
msgstr "Seleccione los libros que desea comprobar con Readest."

msgid "No books selected"
msgstr "No hay libros seleccionados"

msgid "Push selected books to Readest"
msgstr "Enviar los libros seleccionados a Readest"

msgid "Check Readest status"
msgstr "Comprobar el estado de Readest"

msgid "Log in to Readest…"
msgstr "Iniciar sesión en Readest…"

msgid "Log out"
msgstr "Cerrar sesión"

msgid "Customize plugin…"
msgstr "Personalizar complemento…"

msgid "Log out (%s)"
msgstr "Cerrar sesión (%s)"

msgid "your Readest account"
msgstr "su cuenta de Readest"

msgid "Uploaded"
msgstr "Subido"

msgid "Replaced"
msgstr "Reemplazado"

msgid "Updated"
msgstr "Actualizado"

msgid "Up to date"
msgstr "Al día"

msgid "Failed"
msgstr "Fallido"

msgid "In Readest"
msgstr "En Readest"

msgid "Metadata differs"
msgstr "Metadatos diferentes"

msgid "Out of date"
msgstr "Obsoleto"

msgid "Not in Readest"
msgstr "No en Readest"

msgid "No Readest-supported format (EPUB, PDF, ...)"
msgstr "Ningún formato compatible con Readest (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "El archivo del libro falta en la biblioteca de calibre"

msgid "Nothing to push."
msgstr "Nada que enviar."

msgid "Nothing to check."
msgstr "Nada que comprobar."

msgid "Please log in to Readest first. (%s)"
msgstr "Inicie sesión en Readest primero. (%s)"

msgid "Could not reach Readest: %s"
msgstr "No se pudo contactar con Readest: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Readest storage quota exceeded — push stopped."
msgstr "Cuota de almacenamiento de Readest superada: envío detenido."

msgid "Session expired — please log in again."
msgstr "Sesión caducada: inicie sesión de nuevo."

msgid "Login failed"
msgstr "Error de inicio de sesión"

msgid "Not logged in"
msgstr "No ha iniciado sesión"

msgid "Session expired, please log in again"
msgstr "Sesión caducada, inicie sesión de nuevo"

msgid "Not authenticated"
msgstr "No autenticado"

msgid "Request failed (%s)"
msgstr "Error en la solicitud (%s)"

msgid "Upload failed (%s)"
msgstr "Error al subir (%s)"

