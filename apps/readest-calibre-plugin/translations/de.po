#: __init__.py:16
msgid "Push selected books and their metadata into your Readest cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Laden Sie ausgewählte Bücher und ihre Metadaten in Ihre Readest-Cloud-Bibliothek hoch. Ein erneuter Upload aktualisiert den vorhandenen Eintrag, anstatt ein Duplikat zu erstellen."

#: config.py:36
msgid "Not logged in."
msgstr "Nicht angemeldet."

#: config.py:42
msgid "Include custom columns in pushed metadata"
msgstr "Benutzerdefinierte Spalten in die hochgeladenen Metadaten einbeziehen"

#: config.py:51
msgid "Only change this if you run a self-hosted Readest server."
msgstr "Ändern Sie dies nur, wenn Sie einen selbst gehosteten Readest-Server betreiben."

#: config.py:36 ui.py:136
msgid "Logged in as %s."
msgstr "Angemeldet als %s."

