msgstr[0] "%d non riuscito"
msgstr[1] "%d non riusciti"

msgid "%d in Readest"
msgid_plural "%d in Readest"
msgstr[0] "%d in Readest"
msgstr[1] "%d in Readest"

msgid "%d metadata differs"
msgid_plural "%d metadata differs"
msgstr[0] "%d con metadati diversi"
msgstr[1] "%d con metadati diversi"

