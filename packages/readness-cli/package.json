{
  "name": "readness-cli",
  "version": "0.1.0",
  "description": "Node/TS console client for the Readest desktop agent bridge",
  "type": "module",
  "bin": {
    "readness-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "readness-cli": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "readest",
    "readness",
    "ebook",
    "agent",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
